# MongoDB Atlas Configuration (Forever-free M0 Sandbox Cluster)
# Get your free URI at: https://www.mongodb.com/cloud/atlas/register
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/house_of_urja?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin_user:your_password@cluster0.xxxxx.mongodb.net/house_of_urja?retryWrites=true&w=majority
MONGODB_DB=house_of_urja

# Admin Portal Security & Initial Superadmin
SUPERADMIN_EMAIL=admin@houseofurja.us
ADMIN_PASSWORD=hou2026!
ADMIN_SESSION_SECRET=house_of_urja_secure_secret_key_change_in_production

# Canonical Production URL
NEXT_PUBLIC_SITE_URL=https://houseofurja.us
